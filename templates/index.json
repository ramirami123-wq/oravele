    "custom_liquid_PpUV9J": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n.faq-section {\n  max-width: 800px;\n  margin: 30px auto;\n  font-family: Arial, sans-serif;\n}\n\n.faq-title {\n  text-align: center;\n  font-size: 28px;\n  font-weight: bold;\n  margin-bottom: 25px;\n}\n\n.faq-item {\n  border-bottom: 1px solid #ddd;\n  padding: 15px 0;\n}\n\n.faq-question {\n  display: flex;\n  justify-content: space-between;\n  cursor: pointer;\n  font-size: 17px;\n  font-weight: bold;\n}\n\n.faq-answer {\n  display: none;\n  margin-top: 12px;\n  color: #555;\n  font-size: 15px;\n  line-height: 1.6;\n}\n\n.symbol {\n  font-size: 24px;\n  font-weight: bold;\n}\n</style>\n\n\n<div class=\"faq-section\">\n\n<div class=\"faq-title\">Frequently Asked Questions</div>\n\n\n<div class=\"faq-item\">\n<div class=\"faq-question\" onclick=\"toggleFAQ(this)\">\n🚚 How long does delivery take?\n<span class=\"symbol\">+</span>\n</div>\n<div class=\"faq-answer\">\nWe deliver all over Lebanon 🇱🇧. Orders usually arrive within 5–7 days.\n</div>\n</div>\n\n\n<div class=\"faq-item\">\n<div class=\"faq-question\" onclick=\"toggleFAQ(this)\">\n✨ Are your products high quality?\n<span class=\"symbol\">+</span>\n</div>\n<div class=\"faq-answer\">\nYes! We carefully select our beauty and skincare products to provide the best quality and a premium self-care experience.\n</div>\n</div>\n\n\n<div class=\"faq-item\">\n<div class=\"faq-question\" onclick=\"toggleFAQ(this)\">\n💳 How can I order?\n<span class=\"symbol\">+</span>\n</div>\n<div class=\"faq-answer\">\nSimply place your order through our website and we will process it as quickly as possible.\n</div>\n</div>\n\n\n<div class=\"faq-item\">\n<div class=\"faq-question\" onclick=\"toggleFAQ(this)\">\n📱 Can I contact you on WhatsApp?\n<span class=\"symbol\">+</span>\n</div>\n<div class=\"faq-answer\">\nYes! You can contact us anytime on WhatsApp for questions, support, or product information.\n</div>\n</div>\n\n\n</div>\n\n\n<script>\nfunction toggleFAQ(element) {\n\nvar answer = element.nextElementSibling;\nvar symbol = element.querySelector(\".symbol\");\n\nif(answer.style.display === \"block\"){\nanswer.style.display = \"none\";\nsymbol.innerHTML = \"+\";\n}\nelse{\nanswer.style.display = \"block\";\nsymbol.innerHTML = \"-\";\n}\n\n}\n</script>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
